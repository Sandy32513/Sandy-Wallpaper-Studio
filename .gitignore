# ============================================================
# Sandy Wallpaper Studio - .gitignore
# ============================================================

# Virtual Environment
.venv/
venv/
env/

# Python Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / Packaging
build/
dist/
*.egg-info/
*.egg
*.whl

# PyInstaller
*.spec.local
*.manifest
# Build spec outputs produced by scripts (packaging/SandyWallpaperStudio.spec is committed intentionally)
# but any spec auto-generated in root is noise:
/*.spec

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Environment / Secrets
.env
.env.local
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Application Data (user-generated)
cache/
logs/
*.log
*.db
*.db-journal
*.db-wal
*.db-shm

# Runtime files if --library is deliberately pointed at the repository root.
/settings.json
/Library/
/Metadata/
/Cache/
/Temp/
/Logs/
/Exports/
/Duplicates/

# Temporary files
tmp/
temp/
*.tmp

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml

# Type checking
.mypy_cache/
.ruff_cache/

# Testing
.pytest_cache/
