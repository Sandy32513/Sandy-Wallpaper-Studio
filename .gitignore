# ============================================================
# Sandy Wallpaper Studio - .gitignore
# ============================================================

# Virtual Environment
.venv/
venv/
env/

# Python Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / Packaging
build/
dist/
*.egg-info/
*.egg
*.whl

# PyInstaller
*.spec.local
*.manifest

# Environment / Secrets
.env
.env.local
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Application Data (user-generated)
cache/
logs/
*.log
*.db
*.db-journal
*.db-wal
*.db-shm

# Temporary files
tmp/
temp/
*.tmp

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml

# Type checking
.mypy_cache/
.ruff_cache/

# Testing
.pytest_cache/
